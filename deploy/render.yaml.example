# Modelo: substituir os nomes e URLs ANTES de aplicar como Blueprint.
services:
  - type: web
    name: nexforge-crm-api
    runtime: node
    buildCommand: npm ci --include=dev && npm run build -w @nexforge/api
    startCommand: npm run start -w @nexforge/api
    healthCheckPath: /api/v1/health/ready
    envVars:
      - key: NODE_VERSION
        value: "24"
      - key: NODE_ENV
        value: production
      - key: MONGODB_URI
        sync: false
      - key: WEB_ORIGIN
        value: https://SEU-FRONTEND.onrender.com
  - type: web
    name: nexforge-crm-web
    runtime: static
    buildCommand: npm ci --include=dev && npm run build -w @nexforge/web
    staticPublishPath: apps/web/dist
    envVars:
      - key: NODE_VERSION
        value: "24"
    routes:
      - type: rewrite
        source: /api/*
        destination: https://SEU-BACKEND.onrender.com/api/*
      - type: rewrite
        source: /*
        destination: /index.html
    headers:
      - path: /api/*
        name: Cache-Control
        value: no-store
      - path: /index.html
        name: Cache-Control
        value: no-cache
      - path: /sw.js
        name: Cache-Control
        value: no-cache

      - path: /*
        name: Content-Security-Policy
        value: "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://viacep.com.br; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
      - path: /*
        name: X-Content-Type-Options
        value: nosniff
      - path: /*
        name: Referrer-Policy
        value: strict-origin-when-cross-origin
