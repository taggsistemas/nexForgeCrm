{
  "name": "@nexforge/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/server.js",
    "bootstrap": "tsx --env-file-if-exists=../../.env src/modules/identity/bootstrap.ts",
    "master:bootstrap": "tsx --env-file-if-exists=../../.env src/modules/platform/bootstrap.ts",
    "db:diagnose": "tsx --env-file-if-exists=../../.env src/modules/platform/diagnose.ts",
    "db:tax-ids": "tsx --env-file-if-exists=../../.env src/modules/relationships/tax-ids.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "10.2.1",
    "zod": "^4.1.0"
  }
}
